#include <stdio.h>

int main() {
    int total_coins, x, y;
    int ben_share, blackbeard_share, others_share, remaining_coins;

    scanf("%d", &total_coins);
    scanf("%d", &x);
    scanf("%d", &y);

    // Long Ben's absolute share
    ben_share = (total_coins * x) / 100;
    remaining_coins = total_coins - ben_share;

    // Blackbeard's absolute share from remaining
    blackbeard_share = (remaining_coins * y) / 100;
    remaining_coins = remaining_coins - blackbeard_share;

    // Divided equally among the 3 remaining pirates
    others_share = remaining_coins / 3;

    printf("%d\n", ben_share);
    printf("%d\n", blackbeard_share);
    printf("%d\n", others_share);

    return 0;
}

