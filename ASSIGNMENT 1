#include <stdio.h>
#include <string.h>

int main() {
    int distance;
    char member_str[10];
    int is_member = 0;
    float fare = 100.0;

    // Reading inputs
    printf("Distance: ");
    if (scanf("%d", &distance) != 1) return 0;
    printf("Member: ");
    scanf("%s", member_str);

    if (strcmp(member_str, "true") == 0 || strcmp(member_str, "1") == 0) {
        is_member = 1;
    }

    // Additional charge logic
    if (distance > 10) {
        fare += (distance - 10) * 20;
    }

    // Membership discount
    if (is_member) {
        fare = fare * 0.90;
    }

    printf("Final Fare: ₹%.0f\n", fare);
    return 0;
}

